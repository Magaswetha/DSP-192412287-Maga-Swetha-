clc;
clear;
close all;

%% --- Input Parameters ---
fp = 1000;              % High-pass cutoff frequency (Hz)
fs = 8000;              % Sampling frequency (Hz)
N  = 50;                % Filter order

% Normalized cutoff frequency
wc = fp/(fs/2);

%% --- FIR High-Pass using Hanning Window ---
b_hann = fir1(N, wc, 'high', hanning(N+1));

%% --- Display Filter Coefficients ---
disp('--- High-Pass Coefficients (Hanning Window) ---');
disp(b_hann');

%% --- Frequency Response ---
figure;
freqz(b_hann, 1, 1024, fs);
title('High-Pass FIR Filter using Hanning Window');
grid on;
