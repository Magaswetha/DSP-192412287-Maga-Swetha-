clc;
clear;
close all;

%% Generate Input Signal
x = randn(1,1000);

%% Echo Signal
d = filter([0.8 0.5 0.3],1,x);

%% LMS Parameters
mu = 0.01;
M = 3;

w_lms = zeros(M,1);
y_lms = zeros(1,1000);
e_lms = zeros(1,1000);

%% LMS Adaptive Filter
for n = M:1000

    x_vec = x(n:-1:n-M+1)';

    y_lms(n) = w_lms' * x_vec;

    e_lms(n) = d(n) - y_lms(n);

    w_lms = w_lms + mu * e_lms(n) * x_vec;

end

%% NLMS Parameters
mu_nlms = 0.5;
epsilon = 1e-6;

w_nlms = zeros(M,1);
y_nlms = zeros(1,1000);
e_nlms = zeros(1,1000);

%% NLMS Adaptive Filter
for n = M:1000

    x_vec = x(n:-1:n-M+1)';

    y_nlms(n) = w_nlms' * x_vec;

    e_nlms(n) = d(n) - y_nlms(n);

    w_nlms = w_nlms + ...
        (mu_nlms/(epsilon + x_vec'*x_vec)) * ...
        e_nlms(n) * x_vec;

end

%% Figure 1: Input and Echo Signal
figure;

plot(x,'b','LineWidth',1.2);
hold on;
plot(d,'r','LineWidth',1.2);

grid on;
legend('Input','Echo');
title('Input and Echo Signal');
xlabel('Sample Number');
ylabel('Amplitude');

%% Figure 2: LMS Output
figure;

plot(e_lms,'LineWidth',1.2);
grid on;

title('LMS Output');
xlabel('Sample Number');
ylabel('Error');

%% Figure 3: NLMS Output
figure;

plot(e_nlms,'LineWidth',1.2);
grid on;

title('NLMS Output');
xlabel('Sample Number');
ylabel('Error');

%% Figure 4: MSE Comparison
figure;

mse_lms = e_lms.^2;
mse_nlms = e_nlms.^2;

semilogy(mse_lms,'r','LineWidth',1.2);
hold on;
semilogy(mse_nlms,'b','LineWidth',1.2);

grid on;
legend('LMS','NLMS');
title('MSE Comparison');
xlabel('Sample Number');
ylabel('Squared Error');

%% Display Final MSE
fprintf('Average MSE of LMS  = %.6f\n',mean(mse_lms(M:end)));
fprintf('Average MSE of NLMS = %.6f\n',mean(mse_nlms(M:end)));
