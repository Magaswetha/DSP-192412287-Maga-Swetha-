clc;
clear;
close all;

%% Input Parameters
fp = 1000;              % High-pass cutoff frequency (Hz)
fs = 8000;              % Sampling frequency (Hz)
N  = 50;                % Filter order

% Normalized cutoff frequency
wc = fp/(fs/2);

%% FIR High-Pass Filter using Hamming Window
b_hamm = fir1(N, wc, 'high', hamming(N+1));

%% Display Filter Coefficients
disp('--- High-Pass FIR Coefficients using Hamming Window ---');
disp(b_hamm');

%% Frequency Response
figure;
freqz(b_hamm, 1, 1024, fs);
title('High-Pass FIR Filter using Hamming Window');
grid on;

%% Magnitude Response
figure;
[H, f] = freqz(b_hamm, 1, 1024, fs);

plot(f, abs(H));
xlabel('Frequency (Hz)');
ylabel('Magnitude');
title('Magnitude Response of High-Pass FIR Filter');
grid on;

%% Phase Response
figure;
plot(f, angle(H));
xlabel('Frequency (Hz)');
ylabel('Phase (radians)');
title('Phase Response of High-Pass FIR Filter');
grid on;
